{
  "name": "@apx-ui/toolkit",
  "version": "1.0.15",
  "type": "module",
  "description": "Universal Web Utility SDK for apx-ui (AppNA UX/UI) frontend applications",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint -c ./.eslintrc .",
    "lint:fix": "eslint -c ./.eslintrc --fix 'src/**/*.{ts,tsx}'",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "upload": "npm version patch --no-git-tag-version && npm publish"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/appna-io/apx-toolkit.git"
  },
  "keywords": [
    "utility",
    "validation",
    "formatters",
    "date",
    "currency",
    "regex",
    "typescript",
    "frontend",
    "web"
  ],
  "author": "AppNA UX Team",
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-plugin-apx-eslint": "^1.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "tsup": "^8.3.0",
    "typescript": "^5.0.0"
  }
}
