{
  "name": "apx-toolkit-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Monorepo for @apx-ui/toolkit — the universal web utility SDK, plus the interactive playground demo.",
  "workspaces": [
    "package"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "npm run build -w @apx-ui/toolkit",
    "build:demo": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "npm run test -w @apx-ui/toolkit",
    "test:watch": "npm run test:watch -w @apx-ui/toolkit",
    "lint": "npm run lint -w @apx-ui/toolkit",
    "lint:fix": "npm run lint:fix -w @apx-ui/toolkit",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "npm run clean -w @apx-ui/toolkit && rm -rf dist",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/appna-io/apx-toolkit.git"
  },
  "author": "AppNA UX Team",
  "license": "ISC",
  "dependencies": {
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "husky": "^9.1.7",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.0.0",
    "vite": "^5.4.10"
  }
}
